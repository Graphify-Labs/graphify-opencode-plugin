{
  "name": "graphify-opencode",
  "version": "1.1.0",
  "description": "Graphify code intelligence and repository memory for OpenCode, connected through native MCP OAuth.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": ["src", "examples", "LICENSE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test",
    "check": "tsc --noEmit --allowJs --checkJs --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck src/index.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "keywords": ["opencode", "opencode-plugin", "graphify", "mcp", "code-intelligence", "knowledge-graph"],
  "author": "Graphify <founders@graphify.com>",
  "license": "MIT",
  "homepage": "https://graphify.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graphify-Labs/graphify-opencode-plugin.git"
  },
  "bugs": {"url": "https://github.com/Graphify-Labs/graphify-opencode-plugin/issues"},
  "publishConfig": {"access": "public"},
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "typescript": "5.9.3"
  }
}
